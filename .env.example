# ---------------------------------------------------------------------------
# OpenSign — environment variables
# Copy to `.env.local` (Next.js) and fill in the values from
# Supabase Dashboard → Project Settings → API Keys / Data API.
# Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co  (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# anon (public) key — safe for the browser, RLS applies
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — SERVER ONLY (admin user management, signer links, mail log). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (used in e-mail links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Key of the signer identity cookie (/sign) — SERVER ONLY, at least 32 random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Until it is set, a key derived from SUPABASE_SERVICE_ROLE_KEY is used.
SIGN_COOKIE_SECRET=

# Client IP of the audit trail (감사 추적). Behind a reverse proxy that APPENDS to X-Forwarded-For,
# set how many proxies you run (default 1 = the right-most entry). Or name a header your front
# proxy OVERWRITES with the client address (e.g. x-real-ip, x-vercel-forwarded-for).
TRUSTED_PROXY_HOPS=1
TRUSTED_IP_HEADER=

# Outgoing mail (optional). Leave SMTP_HOST empty to only log mails in public.outbound_emails (/dev/mailbox).
# Local Supabase Mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=54325 (UI http://127.0.0.1:54324)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OpenSign <no-reply@example.com>"
